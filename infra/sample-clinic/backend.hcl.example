# Copy outside the repository as backend.hcl and replace placeholders.
# One Terraform workspace is required per environment:
# sample-clinic-dev and sample-clinic-prod.
bucket               = "REPLACE_WITH_TERRAFORM_STATE_BUCKET"
key                  = "sample-clinic/terraform.tfstate"
workspace_key_prefix = "sample-clinic/workspaces"
region               = "ap-northeast-1"
encrypt              = true
use_lockfile         = true
